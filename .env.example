# Copy to .env and fill in. Never commit .env.
GROQ_API_KEY=
GEMINI_API_KEY=
# live = call LLMs; record = call LLMs and save responses to cache/llm_cache.json; replay = cache only, never the network
DEMO_MODE=replay
# FastAPI auth: JSON map of merchant id -> key, and an admin key for reset/retrain
SHOP_KEYS={"S001":"change-me-s001","S002":"change-me-s002"}
ADMIN_KEY=change-me-admin
